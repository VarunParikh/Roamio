rules_version = '2';

// Photo storage (spec §10). Phase 1 uploads no pictures, so uploadsOpen() is
// false and every write is denied (test/rules/storage-pilot.test.ts).
// For the next phase, turn it on: every file is then a compressed WebP of at
// most 1 MB, written once (no overwrite or delete from the app) to a place the
// uploader may write. Checks the uploader's Firestore records, so the same
// people can see a photo as can see what it belongs to.
// Allow + deny tests: test/rules/storage.test.ts. Anything else is denied.
service firebase.storage {
  match /b/{bucket}/o {
    function uploadsOpen() { return false; }
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function doc(path) { return /databases/(default)/documents/$(path); }

    // Signed in and not waiting for parental consent (spec §7).
    function isActive() {
      return signedIn()
        && firestore.exists(doc('users/' + me() + '/private/account'))
        && firestore.get(doc('users/' + me() + '/private/account')).data
             .get('ageStatus', 'none') in ['adult', 'minor_active'];
    }
    function adventure(aid) { return firestore.get(doc('adventures/' + aid)).data; }
    function isMember(aid) { return isActive() && me() in adventure(aid).memberUids; }
    function isLead(aid) {
      let a = adventure(aid);
      return isMember(aid) && (a.leaderUid == me() || me() in a.coLeadUids);
    }

    function isPhoto() {
      // resource == null: new files only, never overwriting one.
      return resource == null
        && request.resource.size <= 1024 * 1024
        && request.resource.contentType == 'image/webp';
    }

    // Memories on a tab: added by the tab's creator (spec UC-21).
    match /adventures/{aid}/tabs/{tid}/{file} {
      allow read: if isMember(aid);
      allow create: if uploadsOpen() && isMember(aid) && isPhoto()
        && firestore.exists(doc('adventures/' + aid + '/tabs/' + tid))
        && firestore.get(doc('adventures/' + aid + '/tabs/' + tid)).data.createdBy == me();
    }

    // A lead's own banner photo (spec UC-10).
    match /adventures/{aid}/banner/{file} {
      allow read: if isMember(aid);
      allow create: if uploadsOpen() && isLead(aid) && isPhoto();
    }

    // Profile photos (spec UC-28): profiles are visible to active users.
    // Uploading needs a finished sign-up (an account record) and a plain
    // file name like the app's random ids.
    match /users/{uid}/avatar/{file} {
      allow read: if signedIn() && (me() == uid || isActive());
      allow create: if uploadsOpen() && signedIn() && me() == uid && isPhoto()
        && file.matches('^[A-Za-z0-9_-]{1,40}[.]webp$')
        && firestore.exists(doc('users/' + uid + '/private/account'));
    }
  }
}
