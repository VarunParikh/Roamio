rules_version = '2';

// Roamio security rules — the privacy boundary (CLAUDE.md, spec §8).
// Data model: docs/DATA_MODEL.md. Every rule has allow + deny tests in
// test/rules/firestore.test.ts. Anything not matched below is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function account(uid) { return get(/databases/$(database)/documents/users/$(uid)/private/account).data; }
    function ageStatus() {
      return exists(/databases/$(database)/documents/users/$(me())/private/account)
        ? account(me()).get('ageStatus', 'none') : 'none';
    }
    // Signed in and not waiting for parental consent (spec §7).
    function isActive() { return signedIn() && ageStatus() in ['adult', 'minor_active']; }
    function isAdult() { return signedIn() && ageStatus() == 'adult'; }

    function adventure(aid) { return get(/databases/$(database)/documents/adventures/$(aid)).data; }
    function isMember(aid) { return isActive() && me() in adventure(aid).memberUids; }
    function isLead(aid) {
      let a = adventure(aid);
      return isMember(aid) && (a.leaderUid == me() || me() in a.coLeadUids);
    }
    function isPal(aid, id) { return exists(/databases/$(database)/documents/adventures/$(aid)/pals/$(id)); }
    function inSquad(aid, id) { return id in adventure(aid).memberUids || isPal(aid, id); }
    // Also someone who has left: they keep their balance (spec UC-16).
    function everInSquad(aid, id) {
      return inSquad(aid, id)
        || exists(/databases/$(database)/documents/adventures/$(aid)/members/$(id));
    }

    function incoming() { return request.resource.data; }
    function changed() { return incoming().diff(resource.data).affectedKeys(); }
    function isDate(v) { return v is string && v.matches('^\\d{4}-\\d{2}-\\d{2}$'); }
    function isCurrency(v) { return v is string && v.matches('^[A-Z]{3}$'); }
    // A tab's location: one point, nothing else (no address, spec §8).
    function isPoint(v) {
      return v is map && v.keys().hasOnly(['lat', 'lng']) && v.keys().hasAll(['lat', 'lng'])
        && v.lat is number && v.lat >= -90 && v.lat <= 90
        && v.lng is number && v.lng >= -180 && v.lng <= 180;
    }
    function isText(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // An amount in minor units: a whole number above zero and at most
    // 10,000,000 in a 3-decimal currency (the app's maxTabMinor), so sums
    // stay exact in Dart and JavaScript.
    function isAmount(v) { return v is int && v > 0 && v <= 10000000000; }
    // Only a photo in one of our own buckets, inside [folder] of adventure
    // [aid] (e.g. 'tabs'), never an outside link that could track members
    // when it loads. Local addresses are the dev emulator.
    function isStoredPhoto(v, aid, folder) {
      let path = '/o/adventures%2F' + aid + '%2F' + folder + '%2F[^/?#]+([?].*)?$';
      return v is string && v.size() <= 1000 && (
        v.matches('^https://firebasestorage[.]googleapis[.]com/v0/b/'
          + 'roamio-(dev|prod)-varun[.](firebasestorage[.]app|appspot[.]com)' + path)
        || v.matches('^http://(10[.]0[.]2[.]2|127[.]0[.]0[.]1|localhost):9199/v0/b/'
          + '[a-z0-9.-]+' + path));
    }
    // Rules can't loop, so each of a tab's (at most 4) memories is checked in turn.
    function isMemories(m, aid) {
      return m is list && m.size() <= 4
        && (m.size() < 1 || isStoredPhoto(m[0], aid, 'tabs'))
        && (m.size() < 2 || isStoredPhoto(m[1], aid, 'tabs'))
        && (m.size() < 3 || isStoredPhoto(m[2], aid, 'tabs'))
        && (m.size() < 4 || isStoredPhoto(m[3], aid, 'tabs'));
    }
    // A display picture's id; the app shows a default for one it doesn't know.
    function isCharacterId(v) { return v is string && v.matches('^[a-z0-9_]{1,30}$'); }
    // The 10 tab categories in app/assets/data/categories.json.
    function isCategory(v) {
      return v in ['pre_trip_preparation', 'primary_transportation', 'accommodation',
        'local_transportation', 'food_dining', 'activities_sightseeing',
        'shopping_souvenirs', 'connectivity_technology', 'incidentals', 'miscellaneous'];
    }

    // ---------- users ----------
    match /users/{uid} {
      function validProfile() {
        return incoming().keys().hasOnly(['name', 'photoUrl', 'bio', 'characterId'])
          && isText(incoming().name, 1, 60)
          && (incoming().get('photoUrl', null) == null || incoming().photoUrl is string)
          && (incoming().get('characterId', null) == null
              || isCharacterId(incoming().characterId))
          && isText(incoming().get('bio', ''), 0, 200);
      }
      // Someone who shares, or shared, a squad (profileReaders, kept by the
      // server; follow-up S3b), or the child's consenting parent.
      function canSee() {
        let readers = /databases/$(database)/documents/profileReaders/$(uid);
        let consent = /databases/$(database)/documents/parentalConsents/$(uid);
        return (exists(readers) && me() in get(readers).data.uids)
          || (exists(consent) && get(consent).data.get('parentUid', null) == me());
      }
      // One profile at a time (get, never list), only for those who share
      // a squad, so nobody can collect names and photos, minors' included.
      // A deleted account just reads as gone ("Deleted user" on tabs).
      allow get: if signedIn() && (me() == uid
        || (isActive() && (resource == null || canSee())));
      allow create, update: if signedIn() && me() == uid && validProfile();

      match /private/account {
        allow read: if signedIn() && me() == uid;
        // Either a date of birth (Phase 2, spec §7) or, in the pilot, the
        // sign-up tick "I'm 18 or older" — never both, never added later.
        allow create: if signedIn() && me() == uid
          && incoming().keys().hasOnly(['dob', 'adultDeclared', 'profileCurrency',
               'consents', 'noticeVersion', 'createdAt', 'fcmTokens'])
          && (incoming().keys().hasAll(['dob'])
                ? isDate(incoming().dob) && !('adultDeclared' in incoming())
                : incoming().get('adultDeclared', false) == true);
        allow update: if signedIn() && me() == uid
          && changed().hasOnly(['profileCurrency', 'consents', 'fcmTokens', 'nominee'])
          && (!('profileCurrency' in changed()) || isCurrency(incoming().profileCurrency))
          && (!('nominee' in changed()) || validNominee(incoming().nominee));

        // Someone to use the person's rights if they can't (DPDP §14):
        // adults only, as a parent or guardian acts for an under-18 (§7).
        function validNominee(n) {
          return n == null || (isAdult()
            && n is map && n.keys().hasAll(['name', 'email']) && n.keys().hasOnly(['name', 'email'])
            && isText(n.name, 1, 80)
            && isText(n.email, 3, 254) && n.email.matches('^[^@\\s]+@[^@\\s]+[.][^@\\s]+$'));
        }
      }

      match /invites/{code} {
        allow read, delete: if signedIn() && me() == uid;
        allow create, update: if signedIn() && me() == uid
          && incoming().keys().hasOnly(['code', 'addedAt'])
          && incoming().code == code;
      }

      // Lead cards such as "<Name> joined your squad" (spec UC-14).
      // Written by Cloud Functions; the owner reads and dismisses them.
      match /notifications/{id} {
        allow read, delete: if signedIn() && me() == uid;
      }
    }

    // ---------- adventures ----------
    match /adventures/{aid} {
      function validMetadata() {
        return isText(incoming().name, 1, 80)
          && isText(incoming().get('description', ''), 0, 500)
          && isDate(incoming().startDate) && isDate(incoming().endDate)
          && incoming().endDate >= incoming().startDate
          && isCurrency(incoming().baseCurrency)
          && isBanner(incoming().get('bannerUrl', null))
          && incoming().get('countryCode', 'XX').matches('^[A-Z]{2}$')
          && isText(incoming().get('city', ''), 0, 80);
      }

      function isBanner(v) { return v == null || isStoredPhoto(v, aid, 'banner'); }

      // Checks the document itself, so "my adventures" queries
      // (memberUids array-contains me) are allowed too.
      allow read: if isActive() && me() in resource.data.memberUids;
      allow create: if isActive()
        && incoming().keys().hasAll(['name', 'countryCode', 'startDate', 'endDate',
             'baseCurrency', 'createdBy', 'leaderUid', 'coLeadUids', 'memberUids'])
        && incoming().keys().hasOnly(['name', 'description', 'countryCode', 'city',
             'startDate', 'endDate', 'baseCurrency', 'bannerUrl', 'createdBy', 'createdAt',
             'leaderUid', 'coLeadUids', 'memberUids'])
        && incoming().createdBy == me()
        && incoming().leaderUid == me()
        && incoming().memberUids == [me()]
        && incoming().coLeadUids == []
        && validMetadata();
      // Membership, roles and hasTabs change only through Cloud Functions.
      allow update: if isLead(aid)
        && changed().hasOnly(['name', 'description', 'city', 'startDate', 'endDate',
             'bannerUrl', 'baseCurrency'])
        && validMetadata()
        && (!('baseCurrency' in changed()) || resource.data.get('hasTabs', false) == false);

      match /members/{uid} {
        allow read: if isMember(aid);
      }

      match /activity/{id} {
        allow read: if isMember(aid);
      }

      match /pals/{pid} {
        allow read: if isMember(aid);
        allow create: if isLead(aid)
          && incoming().keys().hasOnly(['nickname', 'characterId', 'addedBy', 'status', 'createdAt'])
          && isText(incoming().nickname, 1, 30)
          && isCharacterId(incoming().characterId)
          && incoming().addedBy == me()
          && incoming().status == 'active';
        allow update: if isLead(aid)
          && changed().hasOnly(['nickname', 'characterId', 'status'])
          && isText(incoming().nickname, 1, 30)
          // Older pals have none, and can still be edited and removed.
          && (!('characterId' in changed()) || isCharacterId(incoming().characterId))
          && incoming().status in ['active', 'left'];
      }

      match /tabs/{tid} {
        // Shape only; sums and membership of payers/participants are checked
        // by the split engine and a function trigger (DATA_MODEL.md).
        function validTab() {
          let t = incoming();
          return t.keys().hasOnly(['description', 'category', 'amountMinor', 'currency',
                   'date', 'fxDate', 'payers', 'participants', 'percentBp', 'memories',
                   'location', 'createdBy', 'createdAt', 'updatedAt', 'deleted',
                   'baseUpdatedAt'])
            && t.get('baseUpdatedAt', request.time) is timestamp
            && isAmount(t.amountMinor)
            && isCategory(t.get('category', ''))
            && isCurrency(t.currency)
            && isDate(t.date) && isDate(t.fxDate) && t.fxDate <= t.date
            && t.payers is list && t.payers.size() >= 1 && t.payers.size() <= 50
            && t.participants is list && t.participants.size() >= 1
            && t.participants.size() <= 50
            && (t.get('percentBp', null) == null || t.percentBp is map)
            && isMemories(t.get('memories', []), aid)
            && isText(t.get('description', ''), 0, 200)
            && (!('location' in t) || (isAdult() && isPoint(t.location)));
        }

        allow read: if isMember(aid);
        allow create: if isMember(aid)
          && validTab()
          && incoming().createdBy == me()
          && incoming().deleted == false;
        allow update: if isMember(aid) && (
          // the creator edits their own tab, but deleting (and undoing a
          // delete) stays with leads, so it always shows in the activity
          (resource.data.createdBy == me() && validTab()
            && incoming().createdBy == resource.data.createdBy
            && incoming().deleted == resource.data.deleted)
          // a lead soft-deletes any tab, saying who did it (shown in activity)
          || (isLead(aid) && changed().hasOnly(['deleted', 'deletedBy', 'updatedAt'])
            && incoming().deleted == true && incoming().get('deletedBy', '') == me())
        );
      }

      match /settlements/{sid} {
        function validSettlement() {
          let s = incoming();
          return s.keys().hasOnly(['from', 'to', 'amountMinor', 'currency', 'date',
                   'recordedBy', 'createdAt', 'undone'])
            && isAmount(s.amountMinor)
            && s.currency == adventure(aid).baseCurrency
            && isDate(s.get('date', null))
            && s.from != s.to
            && everInSquad(aid, s.from) && everInSquad(aid, s.to)
            && s.recordedBy == me()
            && s.undone == false;
        }
        function mayRecord(s) {
          return me() in [s.from, s.to]
            || (isLead(aid) && (isPal(aid, s.from) || isPal(aid, s.to)));
        }

        allow read: if isMember(aid);
        allow create: if isMember(aid) && validSettlement() && mayRecord(incoming());
        allow update: if isMember(aid)
          && changed().hasOnly(['undone', 'undoneBy'])
          && incoming().undone == true
          && incoming().undoneBy == me()
          && (me() in [resource.data.from, resource.data.to] || isLead(aid));
      }

      // Personal budgets are visible to their owner only (UC-19).
      match /budgets/{uid} {
        allow read, delete: if isMember(aid) && me() == uid;
        allow create, update: if isMember(aid) && me() == uid
          && incoming().keys().hasOnly(['amountMinor', 'currency', 'updatedAt', 'alertsSent'])
          && incoming().get('alertsSent', []) == (resource == null
               ? [] : resource.data.get('alertsSent', []))
          && incoming().amountMinor is int && incoming().amountMinor > 0
          && isCurrency(incoming().currency);
      }
    }

    // ---------- shared, server-written data ----------
    match /invites/{code} {
      allow get: if isActive();
    }

    match /fx_rates/{date} {
      allow read: if isActive();
    }

    match /banners/{country} {
      allow read: if isActive();
    }

    match /parentalConsents/{childUid} {
      allow read: if signedIn() && (me() == childUid || resource.data.parentUid == me());
    }
  }
}
